ELEVENLABS_API_KEY=your_api_key
ELEVENLABS_AGENT_ID=your_agent_id
# Необязательно: индексы устройств из `python speaker.py --list-devices`
# INPUT_DEVICE_INDEX=1
# OUTPUT_DEVICE_INDEX=0
# Необязательно
# WAKE_WORD=стелла
# IDLE_TIMEOUT=8
# Порт страницы для телефона
# PORT=8443
# Разрешить перебивать колонку голосом (по умолчанию 0, чтобы она не слышала себя)
# ALLOW_INTERRUPT=0
# Колонка на плате ищется по имени (номера плавают): default, sysdefault, Headphones (разъём 3.5), hdmi
# OUTPUT_DEVICE_NAME=default
# Секунд, пока микрофон выключен после речи колонки (если она слышит свой хвост, увеличьте)
# ECHO_TAIL=1.6

# Эхоподавление (нужен пакет aec-audio-processing, ставится start.bat сам). AEC=0 выключает.
# AEC=1
# Если колонка медленная (Bluetooth, эхо всё ещё слышно): подсказка задержки в мс, пробуйте 200..500
# ECHO_REF_DELAY_MS=0
# Порог остаточного шума во время речи колонки (громче этого = ваш голос)
# AEC_GATE=200

# Погода: ваш город (Open-Meteo, бесплатно, без ключа). Без этого город определяется по IP (при VPN/WARP ошибётся)
# WEATHER_CITY=Алматы
# Лайк в Spotify: Client ID вашего приложения на developer.spotify.com (см. README), потом python spotify_login.py
# SPOTIFY_CLIENT_ID=

# Окно Spotify на компьютере прячется (музыка играет). SPOTIFY_HIDDEN=0 - не прятать
# SPOTIFY_HIDDEN=1

# Не давать компьютеру засыпать, пока работает Стелла (экран может гаснуть). KEEP_AWAKE=0 - отключить
# KEEP_AWAKE=1

# На какой колонке говорит Стелла (часть названия из `python speaker.py --list-devices`, например V-113).
# Пусто = устройство Windows по умолчанию. Так фильм идёт на динамики ноутбука, а Стелла на своей колонке.
# OUTPUT_DEVICE_NAME=V-113

# На сколько процентов меняют громкость «Стелла, громче/тише»
# VOLUME_STEP=10
