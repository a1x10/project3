ELEVENLABS_API_KEY=your_api_key
ELEVENLABS_AGENT_ID=your_agent_id
# Необязательно: индексы устройств из `python speaker.py --list-devices`
# INPUT_DEVICE_INDEX=1
# OUTPUT_DEVICE_INDEX=0
# Необязательно
# WAKE_WORD=стелла
# IDLE_TIMEOUT=8
# Порт страницы для телефона
# PORT=8443
# Разрешить перебивать колонку голосом (по умолчанию 0, чтобы она не слышала себя)
# ALLOW_INTERRUPT=0
# Колонка на плате ищется по имени (номера плавают): default, sysdefault, Headphones (разъём 3.5), hdmi
# OUTPUT_DEVICE_NAME=default
# Секунд, пока микрофон выключен после речи колонки (если она слышит свой хвост, увеличьте)
# ECHO_TAIL=1.6
