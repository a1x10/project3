# Domain pointing to this VPS (A record). Use :80 to run by IP without HTTPS.
DOMAIN=ai.example.com
PUBLIC_URL=https://ai.example.com

# Telegram bot from @BotFather and your numeric Telegram id (from @userinfobot). Comma-separated for several admins.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# FreeLLMAPI dashboard admin (created automatically) and its encryption key — keep secret.
ROUTER_ADMIN_EMAIL=admin@stella.local
ROUTER_ADMIN_PASSWORD=
FREELLMAPI_ENCRYPTION_KEY=

# Optional: initial system prompt and default model (both editable in the admin panel / bot).
SYSTEM_PROMPT=
DEFAULT_MODEL=auto:smart

# Optional: use any other OpenAI-compatible API instead of FreeLLMAPI.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
