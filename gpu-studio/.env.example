PORT=3000
# Один GPU на всех. RTX-PRO-6000 = 98 кр/час, H100 = 120, L40S = 71 (на L40S не работает Qwen Image)
GPU_TYPE=RTX-PRO-6000
MAX_CREDITS_PER_HOUR=98
IMAGE_MODEL=qwen-image
VIDEO_MODEL=wan-2-2-t2v-a14b
# Через сколько секунд без запросов выключать GPU
IDLE_SECONDS=60
MAX_QUEUED_PER_USER=3
# Если задать — регистрироваться можно только с этим кодом (чтобы чужие не тратили ваши кредиты)
INVITE_CODE=
# Обязательно поменяйте на длинную случайную строку
SESSION_SECRET=
