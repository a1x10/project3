# ============================================================
#  Настройки бота. Скопируйте файл:  cp .env.example .env
#  и заполните. Обязательные поля помечены  [!]
#  Почти всё (график, ИИ, ключи, вход в дневник) потом можно менять
#  в панели управления — без перезапуска. Значения отсюда — «по умолчанию».
# ============================================================

# ---------- BilimClass (электронный дневник) ----------
# [!] Логин и пароль ученика от BilimClass (того, чей дневник показывать)
BILIM_LOGIN=
BILIM_PASSWORD=
# Как школа заполняет дневник:
#   due      — ДЗ стоит на том дне, к которому его нужно сделать (обычно так)
#   assigned — ДЗ стоит на уроке, где его задали; срок = следующий урок по предмету
# Проверить: npm run check — посмотрите, на какой день попало задание.
HOMEWORK_ATTACHED_TO=due
# Часовой пояс школы (Казахстан с 2024 года — UTC+5)
BOT_TIMEZONE=Asia/Almaty

# ---------- WhatsApp ----------
# Номер бота для привязки КОДОМ (удобно на сервере). Только цифры с кодом страны: 77001234567
# Оставьте пустым, чтобы привязать по QR-коду.
WA_PAIRING_NUMBER=
# Номера админов бота (через запятую). Им приходят уведомления об ошибках, им доступны админ-команды.
ADMIN_NUMBERS=
# Админы WhatsApp-группы класса тоже считаются админами бота
GROUP_ADMINS_ARE_BOT_ADMINS=true
# Группа для ДЗ. Проще всего: добавить бота в группу и написать там  !привязать
# Или указать точное название группы, или её ID (видно по команде !id или !группы)
WA_GROUP_NAME=
WA_GROUP_IDS=
# Кто может писать боту в личку: members (участники группы класса) | all | admins | off
PRIVATE_CHAT=members

# ---------- Groq (ИИ) ----------
# [!] Ключ: https://console.groq.com/keys  (бесплатно). Без ключа бот работает, но без ИИ.
# Запасные ключи (того же аккаунта) и запасной ИИ-провайдер добавляются в панели («Ключи и доступ»).
GROQ_API_KEY=
# Модели (актуальны на октябрь 2026; если Groq отключит модель — бот сам перейдёт на запасную)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# ---------- Поведение ИИ ----------
# smart   — отвечает на вопросы по учёбе сам + когда его зовут (рекомендуется)
# mention — только когда зовут: @упоминание, ответ на сообщение бота, «бот, ...», !спросить
# off     — ИИ выключен
AI_MODE=smart
# tutor — объясняет по шагам и даёт ответ;  hints — только подсказки, без готовых ответов
AI_STYLE=tutor
# Отвечать как живой человек: «печатает…», длинное — несколькими сообщениями, без шаблонных фраз
# (на прямой вопрос «ты бот?» бот всё равно честно отвечает, что он бот)
AI_HUMAN_LIKE=true
# Голосовые вопросы: all (все голосовые в группе) | direct (только ответом боту и в личке) | off
AI_VOICE=all
MAX_VOICE_SECONDS=120
# Понимать фото заданий
AI_IMAGES=true
# Имя бота и слова-обращения («бот, как решить...»)
BOT_NAME=Помощник
WAKE_WORDS=бот,ботик,ии,помощник
# Лимиты: вопросов от одного человека за N минут и ответов ИИ в сутки
AI_USER_LIMIT=8
AI_USER_WINDOW_MINUTES=10
AI_DAILY_LIMIT=400
# Сколько последних сообщений чата ИИ видит для контекста
AI_HISTORY_SIZE=14
AI_MAX_ANSWER_CHARS=1800

# ---------- Рассылки ----------
# График по дням недели удобнее всего настроить в панели («График») или командой !график.
# Отсюда берётся график по умолчанию:
#   after_lessons — пн–сб после уроков (через DIGEST_DELAY_MINUTES после последнего урока),
#                   вс — в DIGEST_TIME и только ДЗ на понедельник (без заданий на всю неделю)
#   fixed         — каждый день в DIGEST_TIME (в вс — только на понедельник)
#   off           — без ежедневной рассылки
# Бот присылает только НОВЫЕ задания (уже отправленные не повторяет). Первая рассылка — только «на завтра».
DIGEST_MODE=after_lessons
# Через сколько минут после последнего урока отправлять (чтобы учителя успели заполнить дневник)
DIGEST_DELAY_MINUTES=15
# На сколько дней вперёд искать ДЗ (7 = на каждый день недели)
DIGEST_DAYS_AHEAD=7
# Каждый день присылать «Домашнее задание на завтра» (даже если нового нет).
# false — только дни, где появилось новое ДЗ
DIGEST_REMIND_TOMORROW=true
# Время рассылки в режиме fixed; в режиме after_lessons — для воскресенья и дней без уроков
DIGEST_TIME=18:00
# Утреннее напоминание: расписание + что сдаём сегодня (пусто = выключено)
MORNING_TIME=
# Сводка ДЗ на неделю: день недели (1=пн ... 7=вс) и время (пусто = выключено)
WEEKLY_DAY=7
WEEKLY_TIME=
# Если бот был выключен в момент рассылки — отправить позже (не позднее чем через N минут, а рассылку после уроков — до конца ACTIVE_HOURS)
CATCH_UP_MINUTES=180
# Не отправлять рассылку, если новых ДЗ нет
SKIP_EMPTY_DIGEST=false
# Проверять дневник в течение дня. Новые ДЗ днём копятся до рассылки после уроков
# (кроме заданий на сегодня — о них сразу), а после рассылки приходят сразу.
NOTIFY_CHANGES=true
POLL_INTERVAL_MINUTES=30
# В какое время проверять дневник (ночью не беспокоим)
ACTIVE_HOURS=07:00-22:00
# Как присылать ДЗ:
#   screenshot — настоящий скриншот дня из дневника BilimClass (оценки и пропуски скрыты)
#   card       — нарисованная карточка с ДЗ
#   text       — обычным текстом
# Если скриншот не получился, бот сам отправит карточку.
HOMEWORK_PHOTO=screenshot
# Путь к Chromium (обычно не нужен: бот найдёт браузер сам)
CHROMIUM_PATH=
# Сколько секунд ждать сайт BilimClass при скриншоте
SCREENSHOT_TIMEOUT_SECONDS=45
# Пересылать в группу файлы, прикреплённые к ДЗ
SEND_FILES=true
MAX_FILE_MB=30

# Сколько секунд команды (!дз) и ИИ могут использовать уже скачанный дневник (0 = каждый раз заново).
# Рассылка и проверка изменений ВСЕГДА скачивают дневник заново. Устаревшие данные не показываются никогда.
CACHE_SECONDS=60

# ---------- Панель управления и уведомления ----------
# Пароль для входа в панель (/app). Можно не задавать — тогда вход только по коду, который бот пришлёт
# админам (ADMIN_NUMBERS) в WhatsApp. Пароль можно сменить в самой панели.
ADMIN_PANEL_PASSWORD=
# Включить сайт и панель (false — только /health и /qr)
ADMIN_PANEL=true
# Адрес панели снаружи, если она за HTTPS-прокси (Caddy/nginx): https://bot.example.kz
# Нужен для ссылок из команды !панель. Пусто — ссылки вида http://localhost:ПОРТ (через SSH-туннель)
PANEL_PUBLIC_URL=
# Панель за прокси на этом же сервере: доверять заголовкам X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY=false
# Технические уведомления (BilimClass недоступен, ключ не работает, восстановлено…) админам в личку WhatsApp.
# В группу класса такие сообщения не отправляются никогда.
NOTIFY_ADMINS=true
# Вечерний отчёт админу в 21:00: была ли рассылка, сколько ответов ИИ, были ли проблемы
DAILY_REPORT=false

# ---------- Сервер ----------
# Сайт: http://host:3000/ · панель: /app · состояние: /health · QR в браузере: /qr?token=HTTP_TOKEN
HTTP_PORT=3000
HTTP_HOST=127.0.0.1
# Только для Docker: порт на сервере, если 3000 уже занят другим сервисом
BOT_HTTP_PORT=3000
# Придумайте длинный случайный токен, чтобы открыть QR-код в браузере (пусто = страница /qr выключена)
HTTP_TOKEN=
DATA_DIR=./data
LOG_LEVEL=info
COMMAND_PREFIX=!
