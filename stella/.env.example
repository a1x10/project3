# --- безопасность ---
STELLA_API_KEY=change-me-long-random

# --- мозг ---
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
VISION_MODEL=google/gemini-2.0-flash-001
# для gpt-oss (Groq): low — быстрее и без пустых ответов
LLM_REASONING_EFFORT=

# --- пользователь ---
USER_NAME=Алексей
TZ=Asia/Almaty
VIP_CONTACTS=мама,Аскар
NIGHT_FROM=0
NIGHT_TO=8

# --- голос (base для VPS 2 ГБ, small для 4+ ГБ) ---
WHISPER_MODEL=base
WHISPER_LANG=ru

# --- календарь ---
GOOGLE_TOKEN_FILE=/data/google_token.json
CALENDAR_ID=primary

# --- Home Assistant ---
HA_URL=
HA_TOKEN=
# сущности, требующие подтверждения (кроме всех lock.*)
CONFIRM_ENTITIES=
# {"телевизор":"media_player.sony_bravia","свет":"light.living_room","стиралка":"switch.washer"}
HOME_ALIASES={}

# --- привычки ---
HABIT_MIN_DAYS=4
HABIT_WINDOW_DAYS=14
HABIT_LEAD_MIN=20

# --- стиральная машина (названия режимов — как в интеграции Xiaomi Home) ---
WASHER_ENTITY=switch.washer
WASHER_PROGRAM_SELECT=select.washer_program
WASHER_PROGRAMS={"cotton":"Cotton","synthetic":"Synthetic","delicate":"Delicate","wool":"Wool","quick":"Quick 15","dark":"Dark"}

# --- голос Стеллы (ElevenLabs): ключ в elevenlabs.io -> Profile -> API Keys ---
ELEVENLABS_API_KEY=
# ID голоса: elevenlabs.io -> Voices -> My Voices -> ... -> Copy Voice ID
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_flash_v2_5 — быстрая; eleven_multilingual_v2 — качественнее, но медленнее
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
# ELEVENLABS_SPEED=1.0   # не задавать для eleven_v3

# --- распознавание речи ---
# hybrid: Whisper решает, обратились ли к Стелле, команду уточняет ElevenLabs Scribe (экономит минуты тарифа)
# elevenlabs: всё через Scribe (лучше ловит «Стелла», но тратит минуты на любую услышанную речь)
# whisper: только локально
STT_ENGINE=hybrid
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_KEYTERMS=Стелла,Стела

# --- обращение ---
# 0 = отвечать на любую фразу без слова «Стелла» (мозг молчит на не-команды); 1 = только по обращению
WAKE_REQUIRED=1
# 1 = писать в лог и показывать на экране, что услышала
STT_DEBUG=0
