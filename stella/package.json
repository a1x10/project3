{
  "name": "stella-assistant",
  "version": "1.0.0",
  "description": "Стелла — 3D-ассистент с VRM-аватаром, голосом и управлением компьютером",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:mark": "node tools/generate-mark.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test:e2e": "node tests/e2e/app.e2e.mjs",
    "test:all": "vitest run && node tests/e2e/app.e2e.mjs",
    "installer": "node tools/build-installer.mjs"
  },
  "author": "Stella Team",
  "license": "MIT",
  "dependencies": {
    "@pixiv/three-vrm": "3.3.3",
    "qrcode": "1.5.4",
    "selfsigned": "2.4.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "playwright-core": "1.63.0",
    "vitest": "2.1.8"
  },
  "build": {
    "appId": "app.stella.assistant",
    "productName": "Stella Assistant",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Stella"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Стелла слушает голосовые команды",
        "NSAppleEventsUsageDescription": "Стелла управляет приложениями по вашей просьбе"
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/icon.png",
      "category": "Utility"
    }
  }
}
