# Скопируй в .env и заполни. Ключи хранятся ТОЛЬКО на сервере — в приложение они не попадают.
PORT=8787
HOST=0.0.0.0
# Пароль входа в админ-панель (http://IP:8787/admin)
ADMIN_PASSWORD=смени-меня
# Твои ключи
OPENROUTER_API_KEY=sk-or-v1-...
ELEVENLABS_API_KEY=sk_...
# Модель по умолчанию для пользователей
DEFAULT_MODEL=openai/gpt-4o-mini
# Открытая регистрация (true/false). Если false — аккаунты создаёт только админ.
OPEN_REGISTRATION=true
# Тариф для новых пользователей
DEFAULT_PLAN=free
# Запросов в минуту с одного IP (защита от спама)
IP_RATE_PER_MIN=120
# Папка с базой данных
DATA_DIR=./data
