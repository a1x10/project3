# Скопируйте в .env и заполните:  cp .env.example .env
# .env в git НЕ коммитится.

# ---------- Модель ----------
# Ключ из Claude Console (организация с промокредитами)
ANTHROPIC_API_KEY=sk-ant-...
# agent_sdk — тратит промокредиты (работают только через Claude Agent SDK); messages_api — обычный API
LLM_BACKEND=agent_sdk
# claude-opus-5-5 — самая умная (вдвое дороже Sonnet); claude-sonnet-5-5; claude-haiku-5-5 — самая дешёвая
LLM_MODEL=claude-opus-5-5
# low — быстрее и дешевле для болтовни; medium/high — умнее
LLM_EFFORT=low
# Сколько секунд ждать ответа модели (презентация или видео — длинный ответ)
LLM_TIMEOUT=180
# Поиск в интернете (выполняется у Anthropic, к серверу доступа не даёт)
LLM_WEB_SEARCH=true
# Модель для фоновой выжимки фактов о людях (дешёвая)
LLM_MEMORY_MODEL=claude-haiku-5-5
# С этой даты бот сам перейдёт на запасной вариант (промокредиты действуют до 23.10.2026)
LLM_SWITCH_AT=2026-10-23
LLM_BACKEND_AFTER=messages_api
LLM_MODEL_AFTER=claude-haiku-5-5
# Дневной бюджет, $. После него Стелла отвечает только когда к ней обращаются напрямую
DAILY_BUDGET_USD=12
# Сколько ответов модель готовит одновременно (каждый — отдельный процесс, ~200 МБ памяти)
LLM_CONCURRENCY=3

# ---------- Стикеры, картинки, документы, презентации, таблицы, видео ----------
MEDIA_ENABLED=true
# Сколько файлов она может сделать в один чат за сутки
MEDIA_PER_DAY=40
# Мультики с движением (make_cartoon): рисуются на сервере в отдельном процессе, по одному за раз.
# Сколько мультиков в один чат за сутки (владельцу — без лимита)
ANIM_ENABLED=true
ANIM_PER_DAY=8
# HTML-страницы файлом (make_html): игры, открытки с 3D и анимацией, викторины, сайты. Пишет их отдельный
# вызов Opus 5.5 («студия») с максимальным обдумыванием, потом «арт-директор» смотрит скриншоты страницы из
# браузера и доводит её. Около 5–15 минут и 1–3 $ за страницу (входит в DAILY_BUDGET_USD).
# Быстрее и дешевле: HTML_EFFORT=high (или xhigh). Без доводки: HTML_POLISH=false или сборка с WITH_BROWSER=false.
# Лимиты: HTML_PER_DAY — на чат в сутки (админам без лимита), HTML_PER_DAY_TOTAL — на всех (кроме владельца)
HTML_ENABLED=true
HTML_MODEL=claude-opus-5-5
HTML_EFFORT=max
# Бюджет токенов на страницу (обдумывание + код): модель видит его и распределяет силы, чтобы на effort max
# не упереться в потолок длины ответа (128k). Упёрлась всё равно — одна повторная попытка на effort high
HTML_TASK_BUDGET=100000
HTML_POLISH=true
# Презентации тоже делает студия: слайды рисуются в браузере -> PowerPoint + PDF (нужен WITH_BROWSER=true).
# false — простые редактируемые презентации из списка слайдов
DECK_STUDIO=true
HTML_PER_DAY=4
HTML_PER_DAY_TOTAL=20
# Скинули ссылку на TikTok или YouTube — скачивает ролик и присылает видео ответом на это сообщение
VIDEO_DL_ENABLED=true
VIDEO_DL_PER_DAY=30
# Длиннее (в секундах) не качает; файл больше — пережимает или пропускает (МБ)
VIDEO_DL_MAX_SECONDS=300
VIDEO_DL_MAX_MB=30
# YouTube на серверах часто просит «войти»: cookies.txt из браузера (по умолчанию data/cookies.txt)
VIDEO_DL_COOKIES=
# Видит присланные фото и стикеры; читает присланные файлы (PDF, Word, Excel, PowerPoint)
VISION_ENABLED=true
DOCUMENTS_ENABLED=true
# Голосовые: понимает и отвечает голосом (всё на сервере, бесплатно). WITH_VOICE=false — собрать без них
WITH_VOICE=true
VOICE_ENABLED=true
# base — легче (~0.3 ГБ памяти), small — точнее (~0.6 ГБ; для сервера от 4 ГБ)
VOICE_STT_MODEL=base
VOICE_TTS_VOICE=ru_RU-irina-medium
# Запуск кода — ТОЛЬКО по просьбе владельца (OWNER_PHONE), в песочнице Anthropic (не на сервере)
SANDBOX_ENABLED=true
SANDBOX_MODEL=claude-sonnet-5-5
SANDBOX_PER_DAY=30

# ---------- Панель управления (сайт) ----------
# Два пароля для входа. Задаются ТОЛЬКО здесь, на сервере (в репозиторий их не кладите).
# Пока хоть один пустой — панель выключена. Длиннее — надёжнее.
PANEL_PASSWORD_1=
PANEL_PASSWORD_2=
# Откуда можно открывать панель: адрес GitHub Pages (свой адрес бота /panel/ разрешён всегда)
PANEL_ORIGINS=https://a1x10.github.io
PANEL_PUBLIC_URL=https://a1x10.github.io/project3/
# Сессия: сколько часов живёт и через сколько минут без действий обрывается
PANEL_SESSION_HOURS=8
PANEL_IDLE_MINUTES=30
# Туннель Cloudflare к панели (бесплатный, без домена): включить — раскомментируйте
# COMPOSE_PROFILES=panel

# ---------- Evolution API ----------
# Длинная случайная строка: openssl rand -hex 32
EVOLUTION_API_KEY=change-me-long-random-string
EVOLUTION_INSTANCE=stella
# Секрет вебхука Evolution -> бот: openssl rand -hex 24
WEBHOOK_SECRET=change-me-too
# Пароль Postgres для Evolution
POSTGRES_PASSWORD=change-me-postgres
# Порты на сервере (только 127.0.0.1). Поменяйте, если заняты
EVOLUTION_HOST_PORT=18080
BOT_HOST_PORT=18000

# ---------- База бота ----------
DATABASE_URL=sqlite:///data/bot.db
# Позже: DATABASE_URL=postgresql://user:pass@host:5432/stella

# ---------- Стелла ----------
BOT_NAME=Стелла
BOT_MODEL_NAME=Stells
BOT_CREATOR=Алексей
BOT_PROJECT=Codex
# minimal — просто ИИ-ассистент с короткой базовой инструкцией (по умолчанию); full — подробный характер и правила
PROMPT_STYLE=minimal
# Где общается (для PROMPT_STYLE=full): school — школьный чат (говорит как подросток, понимает сленг, мата нет); none — обычный спокойный стиль
BOT_AUDIENCE=school
# Только для BOT_AUDIENCE=none: 0 или 1 — спокойно, без мата и сленга; 2 — можно крепкие словечки
SWEAR_LEVEL=0
BOT_TIMEZONE=Asia/Almaty

# Владелец: алерты, админ-команды (только цифры, с кодом страны)
OWNER_PHONE=77770000000
# Ещё админы через запятую
ADMIN_PHONES=
ALLOW_DMS=true
# Пусто = все группы, куда добавлена Стелла. Иначе список JID через запятую (…@g.us)
ALLOWED_GROUPS=

# ---------- «Как человек» ----------
REPLY_DELAY_MIN=2
REPLY_DELAY_MAX=5
BATCH_WINDOW_MIN=3
BATCH_WINDOW_MAX=5
TYPING_CHARS_PER_SEC=9
# Опечатки: 0 — пишет грамотно (по умолчанию)
TYPO_RATE=0
TYPO_FIX_RATE=0.4
RATE_LIMIT_PER_MIN=20
# Как часто сама встревает в разговор: off | rare | normal | chatty (в чате: «стелла режим тихий»)
CHIME_IN=normal
# Если владелец сам написал с телефона Стеллы — бот молчит в этом чате N минут
OWNER_TAKEOVER_MINUTES=30
# Сообщения, пришедшие с опозданием больше N минут (после переподключения), — без ответа
REPLY_STALE_MINUTES=30
# Если к ней обратились сразу несколько человек — отвечает каждому отдельно (не больше N за раз)
REPLY_EACH_MAX=5

# ---------- Сама заводит разговор в группах ----------
# В среднем сколько раз в неделю на группу (0 — никогда). Только днём и когда в чате тихо
INITIATIVE_PER_WEEK=2
INITIATIVE_HOURS=10-22
INITIATIVE_MIN_GAP_HOURS=36
INITIATIVE_QUIET_MINUTES=60

# ---------- Память ----------
# Каждые N сообщений Стелла сама анализирует чат и заполняет анкеты участников
MEMORY_EXTRACT_EVERY=15
MEMORY_FACTS_IN_PROMPT=15
MEMORY_PEOPLE_IN_PROMPT=20
# false — то, что Стелла узнала в одном чате, она не рассказывает в другом
MEMORY_SHARE_ACROSS_CHATS=false

# ---------- Казино (игрушечные бананы) ----------
CASINO_START_BALANCE=2000
CASINO_BONUS=500
CASINO_BONUS_HOURS=12

# ---------- Стикеры ----------
# Сохранять стикеры, которые присылают люди (Стелла потом сама их использует)
STICKER_COLLECT=true

# ---------- Алерты ----------
# Куда слать алерт, если WhatsApp отвалился (POST {"text": ...}), например https://ntfy.sh/ваш-топик
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO

# ---------- Telegram (необязательно): та же Стелла в Telegram — рядом с WhatsApp ----------
# Токен бота от @BotFather (/newbot). Пусто — Telegram выключен. В @BotFather: /setprivacy -> Disable,
# иначе в группах бот видит только сообщения, где его отметили через @ или ответили ему
TELEGRAM_BOT_TOKEN=
# Твой id в Telegram (напиши @userinfobot) — по нему Стелла знает владельца (как OWNER_PHONE в WhatsApp)
TELEGRAM_OWNER_ID=
# Только эти группы Telegram (id вида -1001234567890 через запятую); пусто — любые, куда добавили бота
TELEGRAM_ALLOWED_CHATS=
# Бота может найти кто угодно: в личке у каждого (кроме владельца) не больше стольких сообщений в сутки
TELEGRAM_DM_PER_DAY=40
