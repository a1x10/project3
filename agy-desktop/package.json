{
  "name": "agy-desktop",
  "productName": "Agy Desktop",
  "version": "1.0.0",
  "description": "Desktop chat interface for Antigravity CLI (agy) with voice mode",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chrome-devtools-mcp": "^1.13.0",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.11.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.stella.desktop",
    "productName": "Stella",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "control.js",
      "mcp-desktop.js",
      "config.json",
      "mcp-whatsapp.js",
      "cloud.js",
      "renderer/**",
      "package.json",
      "!node_modules/node-pty/build/**",
      "!node_modules/node-pty/deps/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/third_party/**",
      "!node_modules/node-pty/prebuilds/darwin-*/**",
      "!**/*.pdb",
      "!**/*.map",
      "!**/*.md",
      "!**/*.d.ts",
      "!**/*.ts.map",
      "!node_modules/chrome-devtools-mcp/out/Default/gen/third_party/lighthouse/**/locales/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "mcp-whatsapp.js",
      "mcp-desktop.js",
      "node_modules/chrome-devtools-mcp/**"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Stella.exe",
      "requestExecutionLevel": "admin",
      "unpackDirName": "Stella"
    },
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "compression": "maximum"
  }
}