[Unit]
Description=Stella - STELLS Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stella
WorkingDirectory=/opt/project3/stella_bot
ExecStart=/opt/project3/stella_bot/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
