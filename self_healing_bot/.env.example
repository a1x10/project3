# Скопируй в .env и заполни:  cp .env.example .env
# Обязательные строки отмечены [!]. Остальное можно не трогать.

# ===================== Telegram =====================
# [!] Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# [!] Кому можно управлять ботом (через запятую). Свой ID: напиши боту /start — он ответит.
ADMIN_IDS=123456789
# Куда слать алерты (по умолчанию — первому админу в личку; можно ID группы, например -1001234567890)
# ALERT_CHAT_ID=

# ===================== Приложение =====================
# [!] Папка проекта: в ней выполняются команды, оттуда ИИ читает код, там создаются git-ветки
APP_DIR=/home/user/my-app

# [!] Выбери ОДИН из двух режимов.
#
# Режим 1 — бот сам держит процесс (команда должна работать в foreground, без `&` и `-d`):
APP_START_CMD=npm start
#   APP_START_CMD=python3 app.py
#   APP_START_CMD=node server.js
#
# Режим 2 — процессом управляет pm2 / systemd / docker:
#   APP_RESTART_CMD=pm2 restart my-app
#   APP_RESTART_CMD=sudo systemctl restart my-app
#   APP_RESTART_CMD=docker compose restart app

# Как понять, что приложение живо (для режима 2 обязательно что-то одно):
HEALTH_URL=http://127.0.0.1:3000/health
#   HEALTH_URL=tcp://127.0.0.1:5432          # просто проверить, что порт принимает соединения
#   HEALTH_CMD=systemctl is-active --quiet my-app
#   HEALTH_CMD=docker inspect -f '{{.State.Running}}' app | grep -q true
# HEALTH_TIMEOUT=5
# Сколько секунд ждать, пока приложение поднимется после перезапуска
# STARTUP_TIMEOUT=30

# Логи. В режиме 1 по умолчанию пишутся в data/app.log рядом с ботом.
#   APP_LOG_FILE=/var/log/my-app.log
#   APP_LOGS_CMD=pm2 logs my-app --nostream --lines 300
#   APP_LOGS_CMD=journalctl -u my-app -n 300 --no-pager
#   APP_LOGS_CMD=docker logs --tail 300 app
# Порт, который принудительно освобождается перед рестартом (в режиме 1 берётся из HEALTH_URL)
# APP_PORT=3000

# ===================== Мониторинг =====================
# CHECK_INTERVAL=15        # секунд между проверками
# FAILURE_THRESHOLD=2      # сколько проверок подряд должно провалиться, чтобы поднять тревогу
# RESTART_ATTEMPTS=2       # попыток перезапуска, прежде чем звать ИИ
# CRASH_LOOP_MAX=3         # столько автоперезапусков за CRASH_LOOP_WINDOW = «цикл падений» → сразу ИИ
# CRASH_LOOP_WINDOW=600
# REMINDER_INTERVAL=1800   # напоминать, что всё ещё лежит (0 — не напоминать)

# ===================== ИИ =====================
# anthropic (по умолчанию) | openai (любой OpenAI-совместимый API) | none (без ИИ)
AI_PROVIDER=anthropic
AI_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5   # по умолчанию; дешевле: claude-sonnet-5-5, claude-haiku-4-5
# AI_EFFORT=high             # low | medium | high | xhigh | max; для claude-haiku-4-5 поставь none
#
# OpenAI:
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini
# Google Gemini (есть бесплатный тариф, ключ: https://aistudio.google.com/apikey):
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_API_KEY=...
#   AI_MODEL=gemini-2.5-flash
# Groq (бесплатный тариф):
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_API_KEY=gsk_...
#   AI_MODEL=llama-3.3-70b-versatile
# Локальная Ollama (бесплатно, без ключа; маленьким моделям уменьши AI_MAX_FILE_CHARS):
#   AI_PROVIDER=openai
#   AI_BASE_URL=http://127.0.0.1:11434/v1
#   AI_MODEL=qwen2.5-coder:14b

# Имена моделей у провайдеров меняются — сверься с их документацией.

# AI_LOG_LINES=150            # сколько строк логов отправлять
# AI_MAX_FILES=3              # сколько файлов из трейсбека приложить
# AI_MAX_FILE_CHARS=40000     # больше — отправится фрагмент вокруг строки с ошибкой
# AI_EXTRA_FILES=package.json # файлы, которые прикладывать всегда (через запятую)

# ===================== Фиксы и git =====================
# GIT_ENABLED=true            # фикс — в отдельную ветку ai-hotfix/..., откат — через git
# GIT_PUSH=false              # true — пушить ветку с фиксом (нужен доступ к remote без пароля)
# GIT_REMOTE=origin
# FIX_CHECK_CMD=npm test      # команда-проверка после патча, до перезапуска

# ===================== Консоль /cmd =====================
# SHELL_ENABLED=true          # false — выключить /cmd совсем
# SHELL_TIMEOUT=120
