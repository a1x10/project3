# Копируется в /etc/stella/stella.env установщиком (PIN генерируется случайно)
STELLA_DB=/var/lib/stella/stella.db
STELLA_RESCUER_PIN=000000
STELLA_PORTAL_HOST=10.42.0.1
# Координаты места, где стоит хаб (центр карты). Можно оставить пустыми.
STELLA_HUB_LAT=
STELLA_HUB_LON=
STELLA_LLM_URL=http://127.0.0.1:8081/v1/chat/completions
STELLA_LLM_TIMEOUT=90
STELLA_LLM_MAX_TOKENS=120
STELLA_LLM_CONCURRENCY=1
STELLA_LLM_QUEUE_LIMIT=3
# llama.cpp: модель и ядра. У RK3399 ядра 4-5 — быстрые Cortex-A72, 0-3 — Cortex-A53.
LLAMA_MODEL=/opt/stella/models/model.gguf
LLAMA_CPUS=4,5
LLAMA_THREADS=2
LLAMA_CTX=2048
