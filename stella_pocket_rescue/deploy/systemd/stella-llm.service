[Unit]
Description=Stella Rescue: локальная языковая модель (llama.cpp) под присмотром сторожа питания
After=network.target stella-hw.service
Wants=stella-hw.service
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
User=stella
Group=stella
WorkingDirectory=/opt/stella
EnvironmentFile=-/etc/stella/stella.env
ExecStartPre=+/opt/stella/deploy/stella-power.sh
ExecStart=/opt/stella/deploy/stella-llm.sh
Restart=on-failure
RestartSec=30
TimeoutStartSec=240
TimeoutStopSec=20
Nice=10

[Install]
WantedBy=multi-user.target
