[Unit]
Description=Stella Rescue: светодиоды, вентилятор и датчик землетрясения
After=local-fs.target

[Service]
EnvironmentFile=/etc/stella/stella.env
WorkingDirectory=/opt/stella
ExecStart=/opt/stella/venv/bin/python -m app.hardware
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
