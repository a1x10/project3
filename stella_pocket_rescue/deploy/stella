# ------------------------------------------------------------------ обновление из GitHub

cmd_update_github() {
  local repo branch subdir work rc
  local -a rest=()
  while [ $# -gt 0 ]; do
    case "$1" in --github|github) ;; *) rest+=("$1") ;; esac
    shift
  done
  repo=$(setting STELLA_UPDATE_REPO "$DEFAULT_REPO")
  branch=$(setting STELLA_UPDATE_BRANCH "$DEFAULT_BRANCH")
  subdir=$(setting STELLA_UPDATE_SUBDIR "$DEFAULT_SUBDIR")
  [[ "$repo" =~ ^https://[A-Za-z0-9.-]+/[A-Za-z0-9._/-]+$ ]] || fail "неверный STELLA_UPDATE_REPO: $repo"
  [[ "$branch" =~ ^[A-Za-z0-9._/-]+$ ]] || fail "неверный STELLA_UPDATE_BRANCH: $branch"
  [[ "$subdir" =~ ^[A-Za-z0-9._/-]*$ ]] && [[ "$subdir" != *..* ]] || fail "неверный STELLA_UPDATE_SUBDIR"
  have git || fail "нет git: sudo apt install git"
  work=$(mktemp -d /var/tmp/stella-update.XXXXXX 2>/dev/null) || fail "не могу создать папку в /var/tmp"
  say "Скачиваю программу из $repo (ветка $branch), без стенда и презентации"
  if ! timeout 600 git clone -q --depth 1 --filter=blob:none --sparse --branch "$branch" "$repo" "$work/src" 2>"$work/err" \
      || ! git -C "$work/src" sparse-checkout set "${subdir:+$subdir/}app" "${subdir:+$subdir/}deploy" "${subdir:+$subdir/}site" 2>>"$work/err"; then
    err "не удалось скачать: $(tail -n 3 "$work/err" | tr '\n' ' ')"
    rm -rf "$work"
    return 1
  fi
  cmd_update "$work/src${subdir:+/$subdir}" "${rest[@]}"
  rc=$?
  if ! detached_running; then rm -rf "$work"; fi
  return "$rc"
}

