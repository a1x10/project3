  sudo stella remote key                   создать ключ коробки и показать его для сервера
  sudo stella remote pair 'STELLA-PAIR строка'  связать с сервером (строку печатает stella-server.sh)
  sudo stella remote on|off                включить или выключить туннель
  sudo stella remote test                  проверить связь с сервером и сайт через домен
  sudo stella remote ssh on|off            открыть SSH коробки через сервер (выключено по умолчанию)
  sudo stella remote domains КОРОБКА САЙТ  задать домены вручную
  sudo stella tls                          HTTPS без интернета: состояние
  sudo stella tls sync | off               забрать сертификаты с сервера | выключить HTTPS
  sudo stella demo on|off                  демо для стенда: сеть SOS сначала открывает рекламный сайт (12 ч)
  sudo stella update --github              обновиться из GitHub (нужен интернет)
EOF
}

main() {
  local cmd="${1:-status}"
  case "$cmd" in
    help|-h|--help|помощь) usage; return 0 ;;
  esac
  if [ "$(id -u)" != 0 ]; then
    if have sudo; then
      local -a pass=()
      local v
      for v in MODEL JOBS STELLA_QUICK STELLA_HF_BASE STELLA_REBOOT; do
        if [ -n "${!v:-}" ]; then pass+=("$v=${!v}"); fi
      done
      if [ ${#pass[@]} -gt 0 ]; then exec sudo -- env "${pass[@]}" "$SELF" "$@"; fi
      exec sudo -- "$SELF" "$@"
    fi
    fail "нужны права администратора: запустите через sudo"
  fi
  [ $# -gt 0 ] && shift
  SOS_SSID=$(setting STELLA_SSID "$SOS_SSID")
  case "$cmd" in
    status) cmd_status ;;
    home) cmd_home "$@" ;;
    sos) cmd_sos ;;
    update) cmd_update "$@" ;;
    ai) cmd_ai "$@" ;;
    power) cmd_power "$@" ;;
    pin) cmd_pin "$@" ;;
    logs|log) cmd_logs "$@" ;;
    restart) cmd_restart ;;
    admin) cmd_admin "$@" ;;
    wifi) cmd_wifi "$@" ;;
    remote) cmd_remote "$@" ;;
    tls) cmd_tls "$@" ;;
    demo) cmd_demo "$@" ;;
    __render) render_tls_files quiet ;;
    __home-worker) home_worker "$@" ;;
    __sos-worker) sos_worker ;;
    *) err "не знаю команду «$cmd»"; usage; return 1 ;;
  esac
}

if [ "${STELLA_CLI_LIB:-0}" != 1 ]; then
  main "$@"
  exit $?
fi
